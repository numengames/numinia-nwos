---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
// The full-canon index (MIS-087): every .md in the repo, grouped by
// directory. Typed collections keep their own detail routes; everything
// else resolves to /corpus/<path>. Zero silent exclusions — what stays
// out is listed at the bottom.
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/PageHero.astro";
import { getCollection } from "astro:content";
import { getPublicCorpus, SECTIONS } from "@/lib/corpus";

interface Item {
  href: string;
  title: string;
  docId?: string;
  status?: string;
  version?: string;
}

const groups = new Map<string, Item[]>();
const add = (group: string, item: Item) => {
  const list = groups.get(group) ?? [];
  list.push(item);
  groups.set(group, list);
};

for (const e of await getCollection("missions")) {
  const f = e.data as Record<string, any>;
  add("missions", {
    href: `/missions/${String(f.id).toLowerCase()}`,
    title: f.title,
    docId: f.id,
    status: f.status,
  });
}
// One collection for every RPT-* since ADR-005 v1.2.0 (the folder is flat).
for (const e of await getCollection("reports")) {
  const f = e.data as Record<string, any>;
  add("reports", { href: `/reports/${e.id}`, title: f.title, docId: f.id, status: f.status });
}
for (const e of await getCollection("decisions")) {
  const f = e.data as Record<string, any>;
  add("decisions", {
    href: `/decisiones/${String(f.id).toLowerCase()}`,
    title: f.title,
    docId: f.id,
    status: f.status,
  });
}
for (const e of await getCollection("blueprints")) {
  const f = e.data as Record<string, any>;
  add("blueprints", {
    href: `/planos/${String(e.id).replace(/^BLU-\d+-/i, "").toLowerCase()}`,
    title: f.title,
    docId: f.id,
    status: f.status,
  });
}
// Corpus frontmatter varies wildly — display only string values.
const str = (v: unknown) => (typeof v === "string" ? v : undefined);
// The group comes from filePath, not the entry id: the glob loader maps
// a directory's INDEX.md to the bare directory id ("agents/INDEX.md" →
// "agents"), which would mislabel section indexes as root files.
const TOP_DIRS =
  /(?:^|\/)(agents|blueprints|canon|debt|decisions|guilds|missions|operations|protocols|reports|standards)\/(.+)$/;
for (const e of await getPublicCorpus()) {
  const f = e.data as Record<string, unknown>;
  const rel = (e.filePath as string).replace(/\\/g, "/");
  const m = rel.match(TOP_DIRS);
  const dir = m
    ? [m[1], ...m[2].split("/").slice(0, -1)].join("/")
    : "raíz";
  const filename = rel.split("/").pop()!;
  add(dir, {
    href: `/corpus/${e.id}`,
    title: str(f.title) ?? filename,
    docId: str(f.id),
    status: str(f.status),
    version: str(f.version),
  });
}

// "raíz" leads; the rest reads alphabetically.
const groupNames = [...groups.keys()].sort((a, b) =>
  a === "raíz" ? -1 : b === "raíz" ? 1 : a.localeCompare(b)
);
for (const list of groups.values()) {
  list.sort((a, b) => a.href.localeCompare(b.href));
}
const total = [...groups.values()].reduce((n, list) => n + list.length, 0);
---

<Layout
  title="Corpus — Numen Games CAO"
  description="Every .md document of the NWOS canon, mirrored from the repo at build time."
  canonicalPath="/corpus"
  activeNav="corpus"
>
  <PageHero
    label="CAO · NWOS"
    title="Corpus"
    description={`Los ${total} documentos .md del canon, agrupados por directorio y renderizados desde el repo en cada build.`}
  />

  <section class="pb-24">
    <div class="mx-auto max-w-[800px] px-6 space-y-10">

      <!-- MIS-111: the six section indexes. This page lists everything by
           directory; those list one family each, and are where a reader who
           knows what they are looking for should start. -->
      <nav>
        <h2 class="font-mono text-[0.7rem] uppercase tracking-[0.2em] text-accent mb-3">
          Secciones
        </h2>
        <div class="grid gap-2 sm:grid-cols-2">
          {SECTIONS.map((s) => (
            <a
              href={`/corpus/${s.slug}/`}
              class="rounded-lg border border-border bg-card px-4 py-3 hover:bg-card-hover transition-colors"
            >
              <span class="text-sm text-foreground">{s.label}</span>
              <span class="block font-mono text-[0.65rem] text-dim mt-1">{s.blurb}</span>
            </a>
          ))}
        </div>
      </nav>

      {groupNames.map((name) => (
        <div>
          <h2 class="font-mono text-[0.7rem] uppercase tracking-[0.2em] text-accent mb-3">
            {name} <span class="text-dim">· {groups.get(name)!.length}</span>
          </h2>
          <div class="space-y-2">
            {groups.get(name)!.map((item) => (
              <a
                href={item.href}
                class="flex flex-wrap items-baseline gap-x-3 gap-y-1 rounded-lg border border-border bg-card px-4 py-3 hover:bg-card-hover transition-colors"
              >
                {item.docId && <span class="font-mono text-[0.65rem] text-accent">{item.docId}</span>}
                <span class="text-sm text-foreground leading-snug">{item.title}</span>
                {item.status && <span class="font-mono text-[0.6rem] uppercase tracking-widest text-dim">{item.status}</span>}
                {item.version && <span class="font-mono text-[0.6rem] text-dim">v{item.version}</span>}
              </a>
            ))}
          </div>
        </div>
      ))}

      <p class="font-mono text-[0.7rem] text-dim leading-relaxed border-t border-border/50 pt-6">
        Exclusiones (explícitas, MIS-087): solo ficheros .md — «canon/Numinia.
        El juego de rol (manual completo).txt» queda fuera por formato; los .md
        de <code>web/</code> son documentación de la propia app, no canon.
      </p>
    </div>
  </section>
</Layout>
