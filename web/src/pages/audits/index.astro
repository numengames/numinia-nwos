---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
// Audit reports, rendered from the repo's reports/audits/ folder (MIS-066
// pattern: the folder is the source of truth).
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/PageHero.astro";
import { getCollection } from "astro:content";

const audits = (await getCollection("audits")).sort((a, b) =>
  String(b.data.created).localeCompare(String(a.data.created))
);
---

<Layout
  title="Audits — Numen Games CAO"
  description="Audit reports of the NWOS system, rendered from the repo's reports/audits/ folder."
  canonicalPath="/audits"
  activeNav="audits"
>
  <PageHero
    label="CAO · NWOS"
    title="Audits"
    description="Verified diagnoses of the system, straight from the canonical repo."
  />

  <section class="pb-24">
    <div class="mx-auto max-w-[800px] px-6 space-y-4">
      {audits.map((a) => (
        <a
          href={"/audits/" + a.id}
          class="block rounded-xl border border-border bg-card p-6 hover:bg-card-hover transition-colors"
        >
          <div class="flex flex-wrap items-center gap-3 mb-2">
            <span class="font-mono text-[0.65rem] text-accent">{a.data.id}</span>
            <span class="font-mono text-[0.6rem] text-dim">{String(a.data.created).slice(0, 10)}</span>
            <span class="font-mono text-[0.6rem] uppercase tracking-widest text-dim">{a.data.status}</span>
          </div>
          <p class="text-base font-medium text-foreground leading-snug">{a.data.title}</p>
          {a.data.tags.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-2">
              {a.data.tags.slice(0, 6).map((t) => (
                <span class="font-mono text-[0.55rem] text-dim border border-border/50 rounded-full px-2 py-0.5">{t}</span>
              ))}
            </div>
          )}
        </a>
      ))}
    </div>
  </section>
</Layout>
