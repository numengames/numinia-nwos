---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
//
// MIS-111 — a real index per corpus section.
//
// Before this, /corpus/canon/ existed with a <title> reading "Canon — Index"
// and ZERO links to its 12 documents: an artefact of the catch-all detail
// route, not a written page. /corpus/protocols/ did not exist at all — the
// asymmetry that proved these were never indexes.
//
// Every row is derived from the corpus at build time. Nothing is listed by
// hand: a hand-written index is D-031 again, and it goes stale the first time
// a document is added.
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/PageHero.astro";
import { SECTIONS, getSectionDocs } from "@/lib/corpus";

export async function getStaticPaths() {
  return Promise.all(
    SECTIONS.map(async (section) => ({
      params: { section: section.slug },
      props: { section, docs: await getSectionDocs(section.slug) },
    })),
  );
}

const { section, docs } = Astro.props;
---

<Layout
  title={`${section.label} — Corpus NWOS`}
  description={`${section.blurb} ${docs.length} documentos.`}
>
  <PageHero
    label="CAO · NWOS"
    title={section.label}
    description={`${section.blurb} ${docs.length} ${docs.length === 1 ? "documento" : "documentos"}, derivados del repositorio en cada build.`}
  />

  <section class="pb-24">
    <div class="mx-auto max-w-[800px] px-6 space-y-10">
      <div class="space-y-2">
        {docs.map((item) => (
          <a
            href={item.href}
            class="flex flex-wrap items-baseline gap-x-3 gap-y-1 rounded-lg border border-border bg-card px-4 py-3 hover:bg-card-hover transition-colors"
          >
            {item.docId && <span class="font-mono text-[0.65rem] text-accent">{item.docId}</span>}
            <span class="text-sm text-foreground leading-snug">{item.title}</span>
            {item.status && (
              <span class="font-mono text-[0.6rem] uppercase tracking-widest text-dim">{item.status}</span>
            )}
            {item.updated && <span class="font-mono text-[0.6rem] text-dim">{item.updated}</span>}
          </a>
        ))}
      </div>

      {docs.length === 0 && (
        <p class="font-mono text-[0.7rem] text-dim leading-relaxed">
          Esta sección no publica ningún documento todavía. No es un error de
          esta página: los documentos existen en el repositorio y no declaran
          <code>visibility: public</code>, así que el build no los sirve (MIS-114).
        </p>
      )}

      <nav class="border-t border-border/50 pt-6 space-y-2">
        <h2 class="font-mono text-[0.7rem] uppercase tracking-[0.2em] text-accent mb-3">
          Secciones
        </h2>
        <div class="flex flex-wrap gap-2">
          {SECTIONS.map((s) => (
            <a
              href={`/corpus/${s.slug}/`}
              class={
                "rounded-lg border px-3 py-2 font-mono text-[0.7rem] transition-colors " +
                (s.slug === section.slug
                  ? "border-accent/40 bg-accent/10 text-accent"
                  : "border-border bg-card text-dim hover:bg-card-hover")
              }
            >
              {s.label}
            </a>
          ))}
          <a
            href="/corpus/"
            class="rounded-lg border border-border bg-card px-3 py-2 font-mono text-[0.7rem] text-dim hover:bg-card-hover transition-colors"
          >
            Todo el corpus
          </a>
        </div>
      </nav>
    </div>
  </section>
</Layout>
