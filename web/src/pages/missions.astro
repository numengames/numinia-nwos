---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
import PageHero from "@/components/PageHero.astro";
import { getCollection } from "astro:content";

const HUMAN_COST: Record<string, number> = { XS: 130, S: 520, M: 1560, L: 3900, XL: 7800 };
const COMPUTE_MOCK: Record<string, number> = { XS: 0.5, S: 1.5, M: 4, L: 10, XL: 25 };

const PRIORITY_COLOR: Record<string, string> = {
  critical: "bg-red/10 text-red",
  high: "bg-accent/10 text-accent",
  medium: "bg-yellow/10 text-yellow",
  low: "bg-green/10 text-green-400",
};
const PRIORITY_ICON: Record<string, string> = { critical: "🔴", high: "🟠", medium: "🟡", low: "🟢" };
const TYPE_ICON: Record<string, string> = { biological: "🧬", digital: "🤖", hybrid: "🔀" };
const STATUS_COLOR: Record<string, string> = {
  "backlog": "border-border bg-card hover:bg-card-hover",
  "in-progress": "border-accent/20 bg-accent/5 hover:bg-accent/10",
  "in-review": "border-yellow/20 bg-yellow/5 hover:bg-yellow/10",
  "done": "border-green/20 bg-green/5 hover:bg-green/10",
};
const STATUS_ID_COLOR: Record<string, string> = {
  "backlog": "text-dim",
  "in-progress": "text-accent",
  "in-review": "text-yellow",
  "done": "text-green-400",
};

const entries = await getCollection("missions");
const missions = entries
  .map((e) => {
    const f = e.data as Record<string, any>;
    const effort = ["XS", "S", "M", "L", "XL"].includes((f.effort || "").toUpperCase())
      ? (f.effort as string).toUpperCase()
      : "M";
    // draft rides in the backlog column; ordering is the frontend's concern (MIS-066)
    const status = f.status === "draft" ? "backlog" : (f.status as string);
    const type = (f.type_execution || "hybrid") as string;
    return {
      id: (f.id as string).toUpperCase(),
      title: f.title as string,
      status,
      priority: (f.priority as string) || "medium",
      effort,
      guild: (f.guild as string) || "—",
      assignedTo: f.assigned_to && f.assigned_to !== "null" ? (f.assigned_to as string) : null,
      type,
      humanCostEur: HUMAN_COST[effort],
      computeCostEur: type === "biological" ? null : COMPUTE_MOCK[effort],
    };
  })
  .sort((a, b) => a.id.localeCompare(b.id));

const columns = [
  { key: "backlog", label: "Backlog", accent: "text-dim", counter: "bg-border" },
  { key: "in-progress", label: "In Progress", accent: "text-accent", counter: "bg-accent/20" },
  { key: "in-review", label: "In Review", accent: "text-yellow", counter: "bg-yellow/20" },
  { key: "done", label: "Done", accent: "text-green-400", counter: "bg-green/20" },
];
const byStatus = (key: string) => missions.filter((m) => m.status === key);
const frozen = missions.filter((m) => m.status === "frozen");
const cancelled = missions.filter((m) => m.status === "cancelled");

const done = byStatus("done");
const inProg = byStatus("in-progress");
const critical = missions.filter((m) => m.priority === "critical");
const totalHuman = missions.reduce((s, m) => s + m.humanCostEur, 0);
const totalCompute = missions.reduce((s, m) => s + (m.computeCostEur || 0), 0);
const fmt = (n: number) => (n >= 1000 ? "€" + (n / 1000).toFixed(1) + "k" : "€" + Math.round(n));
const fmtSmall = (n: number) => (n < 1 ? "€" + n.toFixed(2) : "€" + n.toFixed(1));

const stats = [
  { value: String(missions.length), label: "Total", box: "border-border bg-card", text: "text-foreground" },
  { value: String(critical.length), label: "🔴 Critical", box: "border-red/20 bg-red/5", text: "text-red" },
  { value: String(inProg.length), label: "⚡ In Progress", box: "border-accent/20 bg-accent/5", text: "text-accent" },
  { value: String(done.length), label: "✅ Done", box: "border-green/20 bg-green/5", text: "text-green-400" },
  { value: fmt(totalHuman), label: "👤 Human est.", box: "border-border bg-card", text: "text-foreground" },
  { value: fmt(totalCompute), label: "🤖 Compute est.", box: "border-accent/10 bg-card", text: "text-accent" },
];
---

<Layout
  title="Missions — Numen Games CAO"
  description="Mission board for the Numen Games CAO, built from the missions/ folder of the numinia-nwos repo at deploy time."
  canonicalPath="/missions"
  activeNav="missions"
>
  <PageHero
    label="CAO · NWOS"
    title="Mission Board"
    description="Every mission in the numinia-nwos repo, rendered from the canonical missions/ folder."
  />

  <section class="pb-24">
    <div class="mx-auto max-w-[1200px] px-4 sm:px-6">

      <!-- Stats -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mb-10">
        {stats.map((s) => (
          <div class={"rounded-xl border p-4 text-center " + s.box}>
            <p class={"font-display text-2xl sm:text-3xl " + s.text}>{s.value}</p>
            <p class="font-mono text-[0.6rem] uppercase tracking-[0.2em] text-dim mt-1">{s.label}</p>
          </div>
        ))}
      </div>

      <!-- Search bar -->
      <div class="mb-6" id="search-container">
        <div class="relative">
          <span class="absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none text-dim" aria-hidden="true">
            <Icon name="magnifying-glass" size={14} />
          </span>
          <input
            id="search-input"
            type="search"
            placeholder="Search missions — ID, title, assignee, guild…"
            autocomplete="off"
            class="w-full bg-card border border-border rounded-xl pl-10 pr-10 py-3 font-mono text-sm text-foreground placeholder:text-dim/40 focus:outline-none focus:border-accent/60 focus:ring-1 focus:ring-accent/20 transition-all duration-200 hover:border-border/80"
            aria-label="Search missions"
          />
          <button
            id="search-clear"
            class="absolute right-3 top-1/2 -translate-y-1/2 text-dim hover:text-foreground transition-colors duration-150 hidden p-0.5 rounded"
            aria-label="Clear search"
            tabindex="0"
          >
            <Icon name="x" size={14} />
          </button>
        </div>
      </div>

      <!-- Filters -->
      <div class="mb-8 space-y-2.5" id="filter-bar">
        <div class="flex flex-wrap gap-2 items-center">
          <span class="font-mono text-[0.6rem] uppercase tracking-widest text-dim w-14 shrink-0">Status</span>
          {["all", "backlog", "in-progress", "in-review", "done"].map((s) => (
            <button data-filter="status" data-value={s}
              class={"filter-btn font-mono text-[0.65rem] px-3 py-1.5 rounded-full border transition-all duration-150 " + (s === "all" ? "border-accent bg-accent/10 text-accent" : "border-border text-dim hover:border-accent/40 hover:text-foreground")}
              aria-pressed={s === "all" ? "true" : "false"}>
              {s === "all" ? "All" : s === "backlog" ? "Backlog" : s === "in-progress" ? "In Progress" : s === "in-review" ? "In Review" : "Done"}
            </button>
          ))}
        </div>
        <div class="flex flex-wrap gap-2 items-center">
          <span class="font-mono text-[0.6rem] uppercase tracking-widest text-dim w-14 shrink-0">Priority</span>
          {["all", "critical", "high", "medium", "low"].map((p) => (
            <button data-filter="priority" data-value={p}
              class={"filter-btn font-mono text-[0.65rem] px-3 py-1.5 rounded-full border transition-all duration-150 " + (p === "all" ? "border-accent bg-accent/10 text-accent" : "border-border text-dim hover:border-accent/40 hover:text-foreground")}
              aria-pressed={p === "all" ? "true" : "false"}>
              {p === "all" ? "All" : p === "critical" ? "🔴 Critical" : p === "high" ? "🟠 High" : p === "medium" ? "🟡 Medium" : "🟢 Low"}
            </button>
          ))}
        </div>
        <div class="flex flex-wrap gap-2 items-center">
          <span class="font-mono text-[0.6rem] uppercase tracking-widest text-dim w-14 shrink-0">Effort</span>
          {["all", "XS", "S", "M", "L", "XL"].map((e) => (
            <button data-filter="effort" data-value={e}
              class={"filter-btn font-mono text-[0.65rem] px-3 py-1.5 rounded-full border transition-all duration-150 " + (e === "all" ? "border-accent bg-accent/10 text-accent" : "border-border text-dim hover:border-accent/40 hover:text-foreground")}
              aria-pressed={e === "all" ? "true" : "false"}>
              {e}
            </button>
          ))}
        </div>
        <div class="flex flex-wrap gap-2 items-center">
          <span class="font-mono text-[0.6rem] uppercase tracking-widest text-dim w-14 shrink-0">Guild</span>
          {["all", "Sentinels", "Alchemists", "Exegetes", "Procurators"].map((g) => (
            <button data-filter="guild" data-value={g}
              class={"filter-btn font-mono text-[0.65rem] px-3 py-1.5 rounded-full border transition-all duration-150 " + (g === "all" ? "border-accent bg-accent/10 text-accent" : "border-border text-dim hover:border-accent/40 hover:text-foreground")}
              aria-pressed={g === "all" ? "true" : "false"}>
              {g}
            </button>
          ))}
        </div>
        <p id="filter-summary" class="font-mono text-[0.6rem] text-dim hidden pt-0.5">
          Showing <span id="filter-count" class="text-accent">0</span> missions
        </p>
      </div>

      <!-- Kanban -->
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-4" id="kanban-board">
        {columns.map((col) => {
          const colMissions = byStatus(col.key);
          return (
            <div class="flex flex-col" data-column={col.key}>
              <div class="flex items-center gap-2 mb-3 px-1">
                <span class={"font-mono text-[0.65rem] uppercase tracking-widest font-semibold " + col.accent}>{col.label}</span>
                <span class={"col-counter inline-flex items-center justify-center w-5 h-5 rounded-full font-mono text-[0.6rem] text-foreground " + col.counter}>{colMissions.length}</span>
              </div>
              <div class="col-cards flex flex-col gap-2 min-h-[80px]" id={"col-" + col.key}>
                {colMissions.length === 0 ? (
                  <div class="rounded-lg border border-dashed border-border/20 p-6 text-center">
                    <p class="font-mono text-[0.6rem] text-dim/30">empty</p>
                  </div>
                ) : colMissions.map((m) => (
                  <a
                    href={"/missions/" + m.id.toLowerCase()}
                    class={(STATUS_COLOR[m.status] || STATUS_COLOR["backlog"]) + " transition-all duration-150 rounded-lg border p-3.5 mission-card cursor-pointer block"}
                    data-status={m.status}
                    data-priority={m.priority}
                    data-effort={m.effort}
                    data-guild={m.guild}
                    data-searchable={[m.id, m.title, m.assignedTo || "", m.guild].join(" ").toLowerCase()}
                  >
                    <div class="flex items-center justify-between mb-2">
                      <span class={"font-mono text-[0.6rem] font-medium " + (STATUS_ID_COLOR[m.status] || "text-dim")}>{m.id}</span>
                      <div class="flex items-center gap-1.5">
                        <span class="font-mono text-[0.55rem] text-dim">{TYPE_ICON[m.type] || "🔀"}</span>
                        <span class="font-mono text-[0.55rem] text-dim">{m.effort}</span>
                        <span class={"inline-flex rounded-full px-1.5 py-0.5 font-mono text-[0.5rem] font-medium " + (PRIORITY_COLOR[m.priority] || "")}>{PRIORITY_ICON[m.priority] || ""}</span>
                      </div>
                    </div>
                    <p class="text-sm font-medium text-foreground leading-snug mb-2.5">{m.title}</p>
                    <div class="flex items-center justify-between">
                      <span class="font-mono text-[0.55rem] text-dim">{m.guild}</span>
                      {m.assignedTo && <span class="font-mono text-[0.5rem] text-dim opacity-70">🗡️ {m.assignedTo}</span>}
                    </div>
                    <div class="mt-2 pt-2 border-t border-border/30 flex items-center justify-between gap-2">
                      <div class="flex items-center gap-1">
                        <span class="font-mono text-[0.5rem] text-dim">👤</span>
                        <span class="font-mono text-[0.5rem] text-dim">{fmt(m.humanCostEur)}</span>
                      </div>
                      {m.computeCostEur != null ? (
                        <div class="flex items-center gap-1">
                          <span class="font-mono text-[0.5rem] text-accent/60">🤖</span>
                          <span class={"font-mono text-[0.5rem] " + (m.status === "done" ? "text-accent" : "text-accent/50")}>{fmtSmall(m.computeCostEur)}{m.status !== "done" ? "*" : ""}</span>
                        </div>
                      ) : (
                        <span class="font-mono text-[0.5rem] text-dim/40">no compute</span>
                      )}
                    </div>
                  </a>
                ))}
              </div>
            </div>
          );
        })}
      </div>

      <!-- Frozen -->
      {frozen.length > 0 && (
        <div class="mt-8">
          <button id="freeze-toggle" class="flex items-center gap-3 w-full text-left mb-3 group" aria-expanded="false">
            <span class="font-mono text-[0.65rem] uppercase tracking-widest text-dim group-hover:text-foreground transition-colors">❄️ Frozen</span>
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-border font-mono text-[0.6rem] text-foreground">{frozen.length}</span>
            <span class="h-px flex-1 bg-border"></span>
            <span id="freeze-chevron" class="font-mono text-[0.6rem] text-dim transition-all">▼ show</span>
          </button>
          <div id="freeze-cards" class="hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            {frozen.map((m) => (
              <div class="rounded-lg border border-dim/20 bg-dim/5 p-3.5 mission-card"
                data-status={m.status} data-priority={m.priority} data-effort={m.effort} data-guild={m.guild}
                data-searchable={[m.id, m.title, m.assignedTo || "", m.guild].join(" ").toLowerCase()}>
                <div class="flex items-center justify-between mb-2">
                  <span class="font-mono text-[0.6rem] text-dim">{m.id}</span>
                  <span class="font-mono text-[0.55rem] text-dim">{m.effort}</span>
                </div>
                <p class="text-sm text-foreground/60 leading-snug mb-2">{m.title}</p>
                <span class="font-mono text-[0.55rem] text-dim">{m.guild}</span>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Cancelled (kept visible: closed, never deleted — P-003/SIM-2.7) -->
      {cancelled.length > 0 && (
        <div class="mt-8">
          <button id="cancel-toggle" class="flex items-center gap-3 w-full text-left mb-3 group" aria-expanded="false">
            <span class="font-mono text-[0.65rem] uppercase tracking-widest text-dim group-hover:text-foreground transition-colors">🚫 Cancelled</span>
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-border font-mono text-[0.6rem] text-foreground">{cancelled.length}</span>
            <span class="h-px flex-1 bg-border"></span>
            <span id="cancel-chevron" class="font-mono text-[0.6rem] text-dim transition-all">▼ show</span>
          </button>
          <div id="cancel-cards" class="hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            {cancelled.map((m) => (
              <a href={"/missions/" + m.id.toLowerCase()}
                class="rounded-lg border border-dim/10 bg-dim/5 p-3.5 mission-card opacity-60 hover:opacity-100 transition-opacity block"
                data-status={m.status} data-priority={m.priority} data-effort={m.effort} data-guild={m.guild}
                data-searchable={[m.id, m.title, m.assignedTo || "", m.guild].join(" ").toLowerCase()}>
                <div class="flex items-center justify-between mb-2">
                  <span class="font-mono text-[0.6rem] text-dim">{m.id}</span>
                  <span class="font-mono text-[0.55rem] text-dim">{m.effort}</span>
                </div>
                <p class="text-sm text-foreground/60 leading-snug mb-2 line-through decoration-dim/40">{m.title}</p>
                <span class="font-mono text-[0.55rem] text-dim">{m.guild}</span>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Footer -->
      <div class="mt-12 grid sm:grid-cols-2 gap-4">
        <div class="rounded-xl border border-border/50 bg-card/50 p-5">
          <p class="font-mono text-[0.65rem] uppercase tracking-widest text-accent mb-3">Cost legend</p>
          <div class="space-y-2">
            <p class="font-mono text-[0.6rem] text-dim leading-relaxed">👤 Human estimate — hours × €65/h freelancer rate</p>
            <p class="font-mono text-[0.6rem] text-dim leading-relaxed">🤖 Compute — AI API cost (mock until MIS-048)</p>
          </div>
        </div>
        <div class="rounded-xl border border-border/50 bg-card/50 p-5">
          <p class="font-mono text-[0.65rem] uppercase tracking-widest text-accent mb-3">About</p>
          <p class="font-mono text-[0.6rem] text-dim leading-relaxed">
            Built from the <span class="text-accent">missions/</span> folder of numinia-nwos
            at deploy time. The repo is the source of truth; every push rebuilds the board.
          </p>
        </div>
      </div>

    </div>
  </section>
</Layout>

<script>
// Filters + search operate on the server-rendered cards (MIS-066: data is
// baked at build; only the interaction layer runs in the browser).
const activeFilters: Record<string, string> = { status: "all", priority: "all", effort: "all", guild: "all" };
let searchQuery = "";

function applyFilters() {
  const q = searchQuery.toLowerCase().trim();
  const cards = document.querySelectorAll<HTMLElement>(".mission-card");
  let visible = 0;

  cards.forEach((card) => {
    const matchFilters =
      (activeFilters.status === "all" || card.dataset.status === activeFilters.status) &&
      (activeFilters.priority === "all" || card.dataset.priority === activeFilters.priority) &&
      (activeFilters.effort === "all" || card.dataset.effort === activeFilters.effort) &&
      (activeFilters.guild === "all" || card.dataset.guild === activeFilters.guild);
    const matchSearch = q === "" || (card.dataset.searchable || "").includes(q);
    const match = matchFilters && matchSearch;
    card.classList.toggle("hidden", !match);
    if (match) visible++;
  });

  for (const key of ["backlog", "in-progress", "in-review", "done"]) {
    const col = document.getElementById("col-" + key);
    if (!col) continue;
    const allCards = [...col.querySelectorAll(".mission-card")];
    if (allCards.length === 0) continue;
    const visibleCount = allCards.filter((c) => !c.classList.contains("hidden")).length;
    let emptyState = col.querySelector(".col-empty-state");
    if (!emptyState) {
      emptyState = document.createElement("div");
      emptyState.className = "col-empty-state rounded-lg border border-dashed border-border/20 p-6 text-center";
      emptyState.innerHTML = '<p class="font-mono text-[0.6rem] text-dim/30">no matches</p>';
      col.appendChild(emptyState);
    }
    emptyState.classList.toggle("hidden", visibleCount > 0);
  }

  const anyActive = Object.values(activeFilters).some((v) => v !== "all") || q !== "";
  const summary = document.getElementById("filter-summary");
  const countEl = document.getElementById("filter-count");
  if (summary && countEl) {
    summary.classList.toggle("hidden", !anyActive);
    countEl.textContent = String(visible);
  }
}

document.querySelectorAll<HTMLElement>(".filter-btn").forEach((btn) => {
  btn.addEventListener("click", () => {
    const ft = btn.dataset.filter as string;
    const val = btn.dataset.value as string;
    activeFilters[ft] = val;
    document.querySelectorAll<HTMLElement>('.filter-btn[data-filter="' + ft + '"]').forEach((b) => {
      const active = b.dataset.value === val;
      b.classList.toggle("border-accent", active);
      b.classList.toggle("bg-accent/10", active);
      b.classList.toggle("text-accent", active);
      b.classList.toggle("border-border", !active);
      b.classList.toggle("text-dim", !active);
      b.setAttribute("aria-pressed", active ? "true" : "false");
    });
    applyFilters();
  });
});

const searchInput = document.getElementById("search-input") as HTMLInputElement | null;
const searchClear = document.getElementById("search-clear");

searchInput?.addEventListener("input", (e) => {
  searchQuery = (e.target as HTMLInputElement).value;
  searchClear?.classList.toggle("hidden", searchQuery === "");
  applyFilters();
});

searchClear?.addEventListener("click", () => {
  if (searchInput) searchInput.value = "";
  searchQuery = "";
  searchClear.classList.add("hidden");
  searchInput?.focus();
  applyFilters();
});

searchInput?.addEventListener("keydown", (e) => {
  if ((e as KeyboardEvent).key === "Escape") searchClear?.click();
});

for (const key of ["freeze", "cancel"]) {
  document.getElementById(key + "-toggle")?.addEventListener("click", () => {
    const content = document.getElementById(key + "-cards");
    const chevron = document.getElementById(key + "-chevron");
    const toggle = document.getElementById(key + "-toggle");
    if (content && chevron) {
      const hidden = content.classList.toggle("hidden");
      chevron.textContent = hidden ? "▼ show" : "▲ hide";
      toggle?.setAttribute("aria-expanded", hidden ? "false" : "true");
    }
  });
}
</script>
