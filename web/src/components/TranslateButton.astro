//
// DEC-006 — translations live in the web layer, not in the repo.
// MIS-120(e) — the button that makes that concrete.
//
// One button. Click it, the page is translated in place. No route, no
// stored artefact, no duplicated .md. The English DOM stays in memory so
// the original is one click away and nothing is lost.
//
// Mechanism: the built-in Translator API (Chrome/Edge 138+, on-device,
// free, private). The browser's own "Translate this page" bar CANNOT be
// triggered from JavaScript — Chromium exposes no such API by design — so
// this does the substitution itself rather than pretending to invoke it.
//
// Everywhere else (Firefox, Safari, mobile) the button degrades to a hint
// pointing at the browser's own translation feature. Nothing breaks.
---

<div class="lang-translate flex items-center gap-0.5 font-mono text-[0.65rem] uppercase tracking-[0.1em]" data-translate-root>
  <button
    type="button"
    data-translate-to="en"
    aria-pressed="true"
    class="rounded-md px-1.5 py-1 text-accent transition-colors"
  >EN</button>
  <span class="text-dim/50">|</span>
  <button
    type="button"
    data-translate-to="es"
    aria-pressed="false"
    class="rounded-md px-1.5 py-1 text-dim transition-colors hover:text-foreground"
  >ES</button>
</div>

<script>
  // The element whose prose we translate. Everything outside it (nav,
  // footer, the button itself) is left alone.
  const ROOT_SELECTOR = "#main";

  // Text nodes only: we never touch tags, attributes or code.
  // <pre>/<code> are skipped — an identifier is not prose, and translating
  // it would corrupt the very commands the corpus documents.
  const SKIP = new Set(["SCRIPT", "STYLE", "PRE", "CODE", "KBD", "SAMP", "NOSCRIPT"]);

  type Slot = { node: Text; en: string };

  let slots: Slot[] | null = null;
  let translated: string[] | null = null;
  let busy = false;
  let current: "en" | "es" = "en";

  function collect(root: Element): Slot[] {
    const out: Slot[] = [];
    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
      acceptNode(node) {
        const text = node.nodeValue ?? "";
        if (!text.trim()) return NodeFilter.FILTER_REJECT;
        let el = node.parentElement;
        while (el && el !== root) {
          if (SKIP.has(el.tagName) || el.closest("[data-translate-root]") === el) {
            return NodeFilter.FILTER_REJECT;
          }
          el = el.parentElement;
        }
        return NodeFilter.FILTER_ACCEPT;
      },
    });
    let n: Node | null;
    while ((n = walker.nextNode())) {
      out.push({ node: n as Text, en: n.nodeValue ?? "" });
    }
    return out;
  }

  function setState(to: "en" | "es") {
    current = to;
    document.querySelectorAll<HTMLElement>("[data-translate-to]").forEach((b) => {
      const on = b.dataset.translateTo === to;
      b.setAttribute("aria-pressed", String(on));
      b.classList.toggle("text-accent", on);
      b.classList.toggle("text-dim", !on);
    });
  }

  function setBusy(on: boolean, label?: string) {
    busy = on;
    document.querySelectorAll<HTMLButtonElement>("[data-translate-to='es']").forEach((b) => {
      b.disabled = on;
      b.textContent = label ?? "ES";
      b.classList.toggle("opacity-60", on);
    });
  }

  function notice(kind: "machine" | "unsupported" | "error", detail = "") {
    document.querySelectorAll("[data-translate-notice]").forEach((n) => n.remove());
    const root = document.querySelector(ROOT_SELECTOR);
    if (!root) return;
    const el = document.createElement("aside");
    el.setAttribute("data-translate-notice", "");
    el.className =
      "mb-6 rounded-xl border border-accent/25 bg-accent/5 px-4 py-3 text-[0.7rem] leading-relaxed text-muted-foreground";
    el.textContent =
      kind === "machine"
        ? "Traducción automática, hecha en tu navegador. El documento inglés es el registro oficial — pulsa EN para volver a él."
        : kind === "unsupported"
          ? "Este navegador no puede traducir la página por sí mismo. Usa la función de traducción de tu navegador (Chrome y Edge de escritorio lo hacen automáticamente). El documento inglés es el registro oficial."
          : "No se pudo completar la traducción" + (detail ? ` (${detail})` : "") + ". El documento sigue en inglés, que es el registro oficial.";
    root.prepend(el);
  }

  function restore() {
    if (!slots) return;
    for (const s of slots) s.node.nodeValue = s.en;
    document.querySelectorAll("[data-translate-notice]").forEach((n) => n.remove());
    document.documentElement.lang = "en";
    setState("en");
  }

  async function translate() {
    const root = document.querySelector(ROOT_SELECTOR);
    if (!root) return;

    // Already done once: swap the cached strings back in, no model call.
    if (translated && slots) {
      slots.forEach((s, i) => (s.node.nodeValue = translated![i]));
      document.documentElement.lang = "es";
      setState("es");
      notice("machine");
      return;
    }

    const API = (globalThis as any).Translator;
    if (!API) {
      notice("unsupported");
      return;
    }

    setBusy(true, "…");
    try {
      const config = { sourceLanguage: "en", targetLanguage: "es" };
      const availability = await API.availability(config);
      if (availability === "unavailable") {
        notice("unsupported");
        return;
      }

      // create() requires transient activation — we are inside the click.
      // A first run downloads the model; report it rather than look frozen.
      const translator = await API.create({
        ...config,
        monitor(m: any) {
          m.addEventListener("downloadprogress", (e: any) => {
            const pct = Math.round((e.loaded ?? 0) * 100);
            setBusy(true, pct > 0 && pct < 100 ? `${pct}%` : "…");
          });
        },
      });

      slots = collect(root);
      const out = new Array<string>(slots.length);

      // Bounded concurrency: the model is on-device and sequential work on a
      // long document is visibly slow, but an unbounded burst starves it.
      const QUEUE = 6;
      let next = 0;
      let done = 0;
      await Promise.all(
        Array.from({ length: Math.min(QUEUE, slots.length) }, async () => {
          while (next < slots!.length) {
            const i = next++;
            const src = slots![i].en;
            try {
              out[i] = await translator.translate(src);
            } catch {
              out[i] = src; // a failed fragment stays English, never blank
            }
            done++;
            setBusy(true, `${Math.round((done / slots!.length) * 100)}%`);
          }
        }),
      );

      translated = out;
      slots.forEach((s, i) => (s.node.nodeValue = out[i]));
      document.documentElement.lang = "es";
      setState("es");
      notice("machine");
      translator.destroy?.();
    } catch (err) {
      notice("error", err instanceof Error ? err.name : "");
      restore();
    } finally {
      setBusy(false);
    }
  }

  document.addEventListener("click", (ev) => {
    const btn = (ev.target as HTMLElement | null)?.closest<HTMLElement>("[data-translate-to]");
    if (!btn || busy) return;
    ev.preventDefault();
    const to = btn.dataset.translateTo === "es" ? "es" : "en";
    if (to === current) return;
    if (to === "es") void translate();
    else restore();
  });
</script>
