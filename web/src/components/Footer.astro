---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
import { navItems } from "@/data/navigation";
import { socialLinks } from "@/data/social-links";
import { VERSION, COMMIT_SHA, COMMIT_URL } from "@/lib/build-info";
import { useT } from "@/i18n/ui";
const t = useT();
---

<footer class="border-t border-border">
  <div class="mx-auto max-w-[1100px] px-6 py-12">
    <div class="flex flex-col items-center justify-between gap-8 sm:flex-row sm:items-start">
      <!-- Brand -->
      <div>
        <a href="/" class="font-display text-2xl text-foreground">
          NW<em class="text-accent">OS</em>
        </a>
        <p class="mt-2 max-w-xs text-sm text-muted-foreground">
          Narrative Work OS — by Numen Games.
        </p>
      </div>

      <!-- Nav links -->
      <div class="flex flex-col gap-2 text-center sm:text-left">
        <span class="mb-1 font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim">{t("footer.navigation")}</span>
        {navItems.map((item) => (
          <a
            href={item.href}
            class="text-sm text-muted-foreground transition-colors hover:text-foreground"
          >
            {item.label}
          </a>
        ))}
      </div>

      <!-- Legal -->
      <div class="flex flex-col gap-2 text-center sm:text-left">
        <span class="mb-1 font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim">{t("footer.legal")}</span>
        <a
          href="/legal/terminos"
          class="text-sm text-muted-foreground transition-colors hover:text-foreground"
        >
          Términos y condiciones
        </a>
        <a
          href="/legal/privacidad"
          class="text-sm text-muted-foreground transition-colors hover:text-foreground"
        >
          Política de privacidad
        </a>
      </div>

      <!-- Social links -->
      <div class="flex flex-col gap-2 text-center sm:text-left">
        <span class="mb-1 font-mono text-[0.65rem] uppercase tracking-[0.2em] text-dim">{t("footer.social")}</span>
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-muted-foreground transition-colors hover:text-accent"
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>

    <!-- Signature -->
    <!--
      No copyright line, and no "all rights reserved": this repository reserves
      almost nothing. Licences differ by folder and every file declares its own
      SPDX identifier, resolved through REUSE.toml — a blanket claim in the
      footer would contradict C-005 and the REUSE manifest at once.

      The shape is numinia.com's: a signature, then the build. Same sentence,
      because it is the same house.
    -->
    <div class="mt-12 border-t border-border/50 pt-6 text-center">
      <p class="text-sm text-muted-foreground">
        by <a
          href="https://numen.games"
          target="_blank"
          rel="noopener noreferrer"
          class="text-foreground transition-colors hover:text-accent"
        >Numen Games</a> — we build for a better future.
      </p>
      <p class="mt-2 font-mono text-[0.65rem] text-dim">
        <a
          href="https://github.com/numen-games/numinia-nwos/blob/main/canon/C-005-licensing.md"
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-accent"
          title="Licensing is per file, declared in REUSE.toml"
        >Open by licence, per file</a>
        {" · "}
        {VERSION}
        {" · "}
        {COMMIT_URL ? (
          <a
            href={COMMIT_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors hover:text-accent"
            title="Ver este commit en GitHub"
          >
            {COMMIT_SHA}
          </a>
        ) : (
          COMMIT_SHA
        )}
      </p>
    </div>
  </div>
</footer>
