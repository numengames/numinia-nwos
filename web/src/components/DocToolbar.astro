---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
// Toolbar for rendered .md detail pages: copy the raw markdown, download
// the canonical file (File over App — the document is the deliverable),
// and listen to it through the browser's own voices (MIS-119).
import Icon from "@/components/Icon.astro";
import SpeechPlayer from "@/components/SpeechPlayer.astro";

interface Props {
  mdUrl: string;      // URL of the raw .md static endpoint
  filename: string;   // canonical repo filename for the download
  pdfUrl?: string;    // URL of the pre-generated PDF (MIS-088)
  lang?: string;      // document language for the speech voice (MIS-119)
}
const { mdUrl, filename, pdfUrl, lang } = Astro.props;
const pdfFilename = filename.replace(/\.md$/i, ".pdf");
import { useT } from "@/i18n/ui";
const t = useT(Astro.currentLocale ?? "en");

---

<div class="doc-toolbar flex flex-wrap items-center justify-start sm:justify-end gap-2 mb-3" data-md-url={mdUrl}>
  <SpeechPlayer lang={lang} />
  <button
    type="button"
    class="copy-md inline-flex items-center gap-1.5 font-mono text-[0.65rem] uppercase tracking-[0.1em] text-dim hover:text-accent border border-border hover:border-accent/40 rounded-lg px-3 py-1.5 transition-colors"
    aria-label={t("toolbar.copyAria")}
    data-t-copy={t("toolbar.copy")}
    data-t-copied={t("toolbar.copied")}
    data-t-error={t("toolbar.error")}
  >
    <Icon name="copy" size={12} />
    <span class="copy-label">{t("toolbar.copy")}</span>
  </button>
  <a
    href={mdUrl}
    download={filename}
    class="inline-flex items-center gap-1.5 font-mono text-[0.65rem] uppercase tracking-[0.1em] text-dim hover:text-accent border border-border hover:border-accent/40 rounded-lg px-3 py-1.5 transition-colors"
    aria-label={t("toolbar.downloadAria", { file: filename })}
  >
    <Icon name="download-simple" size={12} />
    .md
  </a>
  {pdfUrl && (
    <a
      href={pdfUrl}
      download={pdfFilename}
      class="inline-flex items-center gap-1.5 font-mono text-[0.65rem] uppercase tracking-[0.1em] text-dim hover:text-accent border border-border hover:border-accent/40 rounded-lg px-3 py-1.5 transition-colors"
      aria-label={t("toolbar.downloadAria", { file: pdfFilename })}
    >
      <Icon name="file-pdf" size={12} />
      .pdf
    </a>
  )}
</div>

<script>
  for (const bar of document.querySelectorAll<HTMLElement>(".doc-toolbar")) {
    const btn = bar.querySelector<HTMLButtonElement>(".copy-md");
    const label = bar.querySelector<HTMLElement>(".copy-label");
    btn?.addEventListener("click", async () => {
      try {
        const res = await fetch(bar.dataset.mdUrl!);
        await navigator.clipboard.writeText(await res.text());
        if (label) {
          label.textContent = btn.dataset.tCopied || "Copied";
          setTimeout(() => (label.textContent = btn.dataset.tCopy || "Copy"), 1600);
        }
      } catch {
        if (label) label.textContent = btn.dataset.tError || "Error";
      }
    });
  }
</script>
