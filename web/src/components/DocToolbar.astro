---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
// Toolbar for rendered .md detail pages: copy the raw markdown, download
// the canonical file (File over App — the document is the deliverable).
interface Props {
  mdUrl: string;      // URL of the raw .md static endpoint
  filename: string;   // canonical repo filename for the download
}
const { mdUrl, filename } = Astro.props;
---

<div class="doc-toolbar flex items-center justify-end gap-2 mb-3" data-md-url={mdUrl}>
  <button
    type="button"
    class="copy-md inline-flex items-center gap-1.5 font-mono text-[0.65rem] uppercase tracking-[0.1em] text-dim hover:text-accent border border-border hover:border-accent/40 rounded-lg px-3 py-1.5 transition-colors"
    aria-label="Copy raw markdown"
  >
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
    </svg>
    <span class="copy-label">Copy</span>
  </button>
  <a
    href={mdUrl}
    download={filename}
    class="inline-flex items-center gap-1.5 font-mono text-[0.65rem] uppercase tracking-[0.1em] text-dim hover:text-accent border border-border hover:border-accent/40 rounded-lg px-3 py-1.5 transition-colors"
    aria-label={"Download " + filename}
  >
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="3" x2="12" y2="15"/>
    </svg>
    .md
  </a>
</div>

<script>
  for (const bar of document.querySelectorAll<HTMLElement>(".doc-toolbar")) {
    const btn = bar.querySelector<HTMLButtonElement>(".copy-md");
    const label = bar.querySelector<HTMLElement>(".copy-label");
    btn?.addEventListener("click", async () => {
      try {
        const res = await fetch(bar.dataset.mdUrl!);
        await navigator.clipboard.writeText(await res.text());
        if (label) {
          label.textContent = "Copied";
          setTimeout(() => (label.textContent = "Copy"), 1600);
        }
      } catch {
        if (label) label.textContent = "Error";
      }
    });
  }
</script>
