// The house Phosphor subset (Design System §7.3): self-hosted SVGs served
// inline with currentColor. The 26 canonical glyphs plus the four proposed
// in MIS-091 (copy, file-pdf, list, x) — expanding further is an Oracle
// decision, not an import.
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 16, class: className } = Astro.props;

const icons = import.meta.glob<string>("../icons/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});
const raw = icons[`../icons/${name}.svg`];
if (!raw) throw new Error(`Icon not in the house subset: ${name}`);
const svg = raw.replace(
  "<svg ",
  `<svg width="${size}" height="${size}" aria-hidden="true"${className ? ` class="${className}"` : ""} `
);
---

<Fragment set:html={svg} />
