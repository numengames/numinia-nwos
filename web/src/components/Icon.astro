---
// SPDX-FileCopyrightText: 2026 Numen Games S.L.
// SPDX-License-Identifier: MIT
// The house Phosphor subset (Design System §7.3), referenced from the
// shared sprite at /icons.svg — one fetch for the whole site instead of
// re-inlining every path (MIS-093 addendum: 141 KB of duplicated paths in
// the mission board). Expanding the subset is a decision, not an import:
// an unknown name breaks the build.
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 16, class: className } = Astro.props;

const icons = import.meta.glob("../icons/*.svg", { query: "?raw", eager: true });
if (!icons[`../icons/${name}.svg`]) {
  throw new Error(`Icon not in the house subset: ${name}`);
}
---

<svg
  width={size}
  height={size}
  class={className}
  aria-hidden="true"
  focusable="false"
><use href={`/icons.svg#i-${name}`}></use></svg>
